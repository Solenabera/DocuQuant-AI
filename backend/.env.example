# ================================================================
# DocuQuant AI - Environment Configuration
# ================================================================

# Environment Mode: development | staging | production
ENVIRONMENT=development

# Redis Message Broker & State Store (Celery backend)
REDIS_URL=redis://localhost:6379/0

# AI Provider Credentials
# Google Gemini API Key (Get at: https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Groq Cloud API Key (Optional fallback: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Default LLM Provider: google | groq
DEFAULT_LLM_PROVIDER=google

# Multi-Agent LangGraph Settings
CIRCUIT_BREAKER_MAX_REVISIONS=3
MAX_FILE_SIZE_MB=50

# CORS Allowed Origins (JSON list or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
